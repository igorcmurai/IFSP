<?xml version="1.0" encoding="UTF-8" ?>

<Application
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TarefasApp.App">

    <Application.Resources>

        <ResourceDictionary>

            <!-- ========================= -->
            <!-- MATERIAL 3 - CORES -->
            <!-- ========================= -->

            <Color x:Key="M3Primary">#6750A4</Color>
            <Color x:Key="M3OnPrimary">#FFFFFF</Color>

            <Color x:Key="M3PrimaryContainer">#EADDFF</Color>
            <Color x:Key="M3OnPrimaryContainer">#21005D</Color>

            <Color x:Key="M3Secondary">#625B71</Color>
            <Color x:Key="M3OnSecondary">#FFFFFF</Color>

            <Color x:Key="M3SecondaryContainer">#E8DEF8</Color>
            <Color x:Key="M3OnSecondaryContainer">#1D192B</Color>

            <Color x:Key="M3Surface">#FFFBFE</Color>
            <Color x:Key="M3SurfaceContainer">#F3EDF7</Color>
            <Color x:Key="M3SurfaceContainerHigh">#ECE6F0</Color>

            <Color x:Key="M3OnSurface">#1D1B20</Color>
            <Color x:Key="M3OnSurfaceVariant">#49454F</Color>

            <Color x:Key="M3Outline">#79747E</Color>
            <Color x:Key="M3OutlineVariant">#CAC4D0</Color>

            <Color x:Key="M3Error">#B3261E</Color>
            <Color x:Key="M3OnError">#FFFFFF</Color>


            <!-- DARK -->

            <Color x:Key="M3DarkPrimary">#D0BCFF</Color>
            <Color x:Key="M3DarkOnPrimary">#381E72</Color>

            <Color x:Key="M3DarkPrimaryContainer">#4F378B</Color>
            <Color x:Key="M3DarkOnPrimaryContainer">#EADDFF</Color>

            <Color x:Key="M3DarkSurface">#141218</Color>
            <Color x:Key="M3DarkSurfaceContainer">#211F26</Color>
            <Color x:Key="M3DarkSurfaceContainerHigh">#2B2930</Color>

            <Color x:Key="M3DarkOnSurface">#E6E0E9</Color>
            <Color x:Key="M3DarkOnSurfaceVariant">#CAC4D0</Color>

            <Color x:Key="M3DarkOutline">#938F99</Color>
            <Color x:Key="M3DarkOutlineVariant">#49454F</Color>

            <Color x:Key="M3DarkError">#F2B8B5</Color>


            <!-- ========================= -->
            <!-- TIPOGRAFIA -->
            <!-- ========================= -->

            <Style
                x:Key="M3HeadlineLarge"
                TargetType="Label">

                <Setter Property="FontSize"
                        Value="32" />

                <Setter Property="FontAttributes"
                        Value="Bold" />

                <Setter Property="TextColor"
                        Value="{AppThemeBinding
                            Light={StaticResource M3OnSurface},
                            Dark={StaticResource M3DarkOnSurface}}" />

            </Style>


            <Style
                x:Key="M3TitleLarge"
                TargetType="Label">

                <Setter Property="FontSize"
                        Value="22" />

                <Setter Property="FontAttributes"
                        Value="Bold" />

                <Setter Property="TextColor"
                        Value="{AppThemeBinding
                            Light={StaticResource M3OnSurface},
                            Dark={StaticResource M3DarkOnSurface}}" />

            </Style>


            <Style
                x:Key="M3TitleMedium"
                TargetType="Label">

                <Setter Property="FontSize"
                        Value="16" />

                <Setter Property="FontAttributes"
                        Value="Bold" />

                <Setter Property="TextColor"
                        Value="{AppThemeBinding
                            Light={StaticResource M3OnSurface},
                            Dark={StaticResource M3DarkOnSurface}}" />

            </Style>


            <Style
                x:Key="M3BodyMedium"
                TargetType="Label">

                <Setter Property="FontSize"
                        Value="14" />

                <Setter Property="TextColor"
                        Value="{AppThemeBinding
                            Light={StaticResource M3OnSurfaceVariant},
                            Dark={StaticResource M3DarkOnSurfaceVariant}}" />

            </Style>


            <!-- ========================= -->
            <!-- CAMPOS -->
            <!-- ========================= -->

            <Style
                x:Key="M3Entry"
                TargetType="Entry">

                <Setter Property="BackgroundColor"
                        Value="Transparent" />

                <Setter Property="TextColor"
                        Value="{AppThemeBinding
                            Light={StaticResource M3OnSurface},
                            Dark={StaticResource M3DarkOnSurface}}" />

                <Setter Property="PlaceholderColor"
                        Value="{AppThemeBinding
                            Light={StaticResource M3OnSurfaceVariant},
                            Dark={StaticResource M3DarkOnSurfaceVariant}}" />

                <Setter Property="FontSize"
                        Value="16" />

                <Setter Property="HeightRequest"
                        Value="48" />

            </Style>


            <Style
                x:Key="M3Editor"
                TargetType="Editor">

                <Setter Property="BackgroundColor"
                        Value="Transparent" />

                <Setter Property="TextColor"
                        Value="{AppThemeBinding
                            Light={StaticResource M3OnSurface},
                            Dark={StaticResource M3DarkOnSurface}}" />

                <Setter Property="PlaceholderColor"
                        Value="{AppThemeBinding
                            Light={StaticResource M3OnSurfaceVariant},
                            Dark={StaticResource M3DarkOnSurfaceVariant}}" />

                <Setter Property="FontSize"
                        Value="16" />

            </Style>


            <Style
                x:Key="M3Picker"
                TargetType="Picker">

                <Setter Property="BackgroundColor"
                        Value="Transparent" />

                <Setter Property="TextColor"
                        Value="{AppThemeBinding
                            Light={StaticResource M3OnSurface},
                            Dark={StaticResource M3DarkOnSurface}}" />

                <Setter Property="TitleColor"
                        Value="{AppThemeBinding
                            Light={StaticResource M3OnSurfaceVariant},
                            Dark={StaticResource M3DarkOnSurfaceVariant}}" />

                <Setter Property="FontSize"
                        Value="16" />

                <Setter Property="HeightRequest"
                        Value="52" />

            </Style>


            <Style
                x:Key="M3DatePicker"
                TargetType="DatePicker">

                <Setter Property="BackgroundColor"
                        Value="Transparent" />

                <Setter Property="TextColor"
                        Value="{AppThemeBinding
                            Light={StaticResource M3OnSurface},
                            Dark={StaticResource M3DarkOnSurface}}" />

                <Setter Property="FontSize"
                        Value="16" />

                <Setter Property="HeightRequest"
                        Value="52" />

            </Style>


            <!-- ========================= -->
            <!-- BOTÕES -->
            <!-- ========================= -->

            <Style
                x:Key="M3FilledButton"
                TargetType="Button">

                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding
                            Light={StaticResource M3Primary},
                            Dark={StaticResource M3DarkPrimary}}" />

                <Setter Property="TextColor"
                        Value="{AppThemeBinding
                            Light={StaticResource M3OnPrimary},
                            Dark={StaticResource M3DarkOnPrimary}}" />

                <Setter Property="CornerRadius"
                        Value="20" />

                <Setter Property="HeightRequest"
                        Value="48" />

                <Setter Property="Padding"
                        Value="24,0" />

                <Setter Property="FontAttributes"
                        Value="Bold" />

                <Setter Property="FontSize"
                        Value="14" />

            </Style>


            <Style
                x:Key="M3TonalButton"
                TargetType="Button">

                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding
                            Light={StaticResource M3SecondaryContainer},
                            Dark={StaticResource M3DarkPrimaryContainer}}" />

                <Setter Property="TextColor"
                        Value="{AppThemeBinding
                            Light={StaticResource M3OnSecondaryContainer},
                            Dark={StaticResource M3DarkOnPrimaryContainer}}" />

                <Setter Property="CornerRadius"
                        Value="20" />

                <Setter Property="HeightRequest"
                        Value="48" />

                <Setter Property="Padding"
                        Value="24,0" />

                <Setter Property="FontAttributes"
                        Value="Bold" />

            </Style>


            <Style
                x:Key="M3ErrorButton"
                TargetType="Button">

                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding
                            Light={StaticResource M3Error},
                            Dark={StaticResource M3DarkError}}" />

                <Setter Property="TextColor"
                        Value="{AppThemeBinding
                            Light={StaticResource M3OnError},
                            Dark=#601410}" />

                <Setter Property="CornerRadius"
                        Value="20" />

                <Setter Property="HeightRequest"
                        Value="48" />

                <Setter Property="FontAttributes"
                        Value="Bold" />

            </Style>

        </ResourceDictionary>

    </Application.Resources>

</Application>