<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CBTPRDM_TP01.MainPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#202020">

    <!--
        CBTPRDM - Trabalho Prático 01

        Autores:
        Igor Cerqueira Murai - CB3033295
        Gustavo Cerqueira Murai - CB3033261
    -->

    <Grid>

        <Border
            WidthRequest="360"
            Padding="24"
            BackgroundColor="Black"
            Stroke="Black"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <VerticalStackLayout Spacing="14">

                <Label
                    Text="Aplicação Teste"
                    TextColor="White"
                    FontSize="28"
                    FontAttributes="Bold"
                    Margin="0,0,0,18" />

                <Grid
                    ColumnDefinitions="70,*"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="14">

                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="ID:"
                        TextColor="White"
                        FontSize="22"
                        FontAttributes="Bold"
                        VerticalTextAlignment="Center" />

                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Stroke="White"
                        StrokeThickness="2"
                        Padding="0">

                        <Entry
                            x:Name="IdEntry"
                            BackgroundColor="Black"
                            TextColor="White"
                            FontSize="18"
                            HeightRequest="42"
                            Margin="8,0" />

                    </Border>

                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="Pass"
                        TextColor="White"
                        FontSize="22"
                        FontAttributes="Bold"
                        VerticalTextAlignment="Center" />

                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Stroke="White"
                        StrokeThickness="2"
                        Padding="0">

                        <Entry
                            x:Name="SenhaEntry"
                            BackgroundColor="Black"
                            TextColor="White"
                            FontSize="18"
                            HeightRequest="42"
                            Margin="8,0"
                            IsPassword="True" />

                    </Border>

                </Grid>

                <BoxView
                    HeightRequest="30"
                    Opacity="0" />

                <Button
                    x:Name="OkButton"
                    Text="OK"
                    BackgroundColor="#D9D9D9"
                    TextColor="#A41432"
                    FontSize="20"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="0"
                    Clicked="OnOkClicked" />

                <Button
                    x:Name="LimparButton"
                    Text="Limpar"
                    BackgroundColor="#D9D9D9"
                    TextColor="#A41432"
                    FontSize="20"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="0"
                    Clicked="OnLimparClicked" />

                <Button
                    x:Name="CreditosButton"
                    Text="Créditos"
                    BackgroundColor="#D9D9D9"
                    TextColor="#A41432"
                    FontSize="20"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="0"
                    Clicked="OnCreditosClicked" />

            </VerticalStackLayout>

        </Border>

    </Grid>

</ContentPage>